\* Boot initialization — run after loading all KL files *\

(shen.initialise-environment)
(trap-error (shen.initialise-signedfuncs) (lambda E ()))
(trap-error (stlib.initialise-environment) (lambda E ()))
(trap-error (shen.x.features.initialise ()) (lambda E ()))

\* Lambda forms are built on demand by the patched fn function below. *\

\* Macro: quote the type argument in declare so it isn't evaluated.
   Rewrites (declare Name Type) to (shen.declare* Name QuotedType)
   to avoid re-expansion. *\
(defun shen.declare* (Name Type) (declare Name Type))

(defun shen.declare-macro (V)
  (if (and (cons? V) (and (= declare (hd V))
          (and (cons? (tl V)) (and (cons? (tl (tl V)))
                                   (= () (tl (tl (tl V))))))))
      (cons shen.declare* (cons (hd (tl V))
                           (cons (shen.rcons_form (hd (tl (tl V)))) ())))
      V))


\* Macro: quote both args in shen.typecheck.
   Rewrites (shen.typecheck Expr Type) to (shen.typecheck* QuotedExpr QuotedType)
   so the type checker gets source expressions, not evaluated values. *\
(defun shen.typecheck* (Expr Type) (shen.typecheck Expr Type))

(defun shen.typecheck-macro (V)
  (if (and (cons? V) (and (= shen.typecheck (hd V))
          (and (cons? (tl V)) (and (cons? (tl (tl V)))
                                   (= () (tl (tl (tl V))))))))
      (cons shen.typecheck* (cons (shen.rcons_form (hd (tl V)))
                             (cons (shen.rcons_form (hd (tl (tl V)))) ())))
      V))

(shen.record-macro shen.declare-macro (lambda X (shen.declare-macro X)))
(shen.record-macro shen.typecheck-macro (lambda X (shen.typecheck-macro X)))

\* Patch fn to auto-build lambda forms on miss *\
(defun fn (X)
  (cond ((= (arity X) 0) (X))
        (true (trap-error
                (get X shen.lambda-form (value *property-vector*))
                (lambda E
                  (let Entry (shen.lambda-entry X)
                    (if (cons? Entry)
                        (do (shen.set-lambda-form-entry Entry) (tl Entry))
                        (simple-error (cn "fn: " (shen.app X " is undefined\n" shen.a))))))))))
